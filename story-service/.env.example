# ---- Application ----
APP_NAME=KATHAVOX
NODE_ENV=development
PORT=8080
API_PREFIX=api/v1
API_VERSION=1.0
SWAGGER_PATH=api-docs
FRONTEND_ORIGIN=http://localhost:4200
FRONTEND_VERIFY_EMAIL_PATH=/auth/verify-email
FRONTEND_RESET_PASSWORD_PATH=/auth/reset-password
FRONTEND_SET_PASSWORD_PATH=/auth/set-password

# ---- PostgreSQL ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=story_platform
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_LOGGING=false
DATABASE_MIGRATIONS_TABLE=typeorm_migrations

# ---- Authentication ----
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=5m
REFRESH_TOKEN_EXPIRES_IN=5h
REFRESH_COOKIE_NAME=kv_refresh
COOKIE_SECURE=false
EMAIL_VERIFICATION_TOKEN_TTL=24h
PASSWORD_RESET_TOKEN_TTL=1h
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=128
CSRF_HEADER_NAME=X-Requested-With
CSRF_HEADER_VALUE=KATHAVOX-Web

# ---- Rate limiting ----
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=5
RECOVERY_THROTTLE_LIMIT=3

# ---- API behaviour ----
PAGINATION_DEFAULT_LIMIT=12
PAGINATION_MAX_LIMIT=50
PUBLIC_CACHE_MAX_AGE_SECONDS=60

# ---- Uploads ----
UPLOAD_DIRECTORY=uploads
UPLOAD_URL_PATH=/uploads

# ---- Book PDF export (admin) ----
PDF_FONT_PATH=assets/fonts/NotoSansOriya-Regular.ttf
PDF_PAGE_SIZE=A4
PDF_MARGIN_MM=20

# ---- Payments (Razorpay test mode; used from Phase 5) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# ---- Advertising ----
ADS_ENABLED=false

# ---- Payments reporting (minutes from UTC; India = 330) ----
PAYMENTS_UTC_OFFSET_MINUTES=330

# ---- Seed (first admin, used by npm run seed) ----
ADMIN_SEED_NAME=Administrator
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ---- Email (optional). Empty SMTP_HOST writes emails to the server log. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KATHAVOX <no-reply@localhost>

# ---- Sample users (local testing only; created by npm run seed) ----
SEED_SAMPLE_USER_PASSWORD=

# ---- Stories and uploads ----
UPLOAD_MAX_COVER_BYTES=2097152
UPLOAD_MAX_IMAGE_BYTES=3145728
STORY_DEFAULT_FREE_PREVIEW_PAGES=2
STORY_MAX_PAGE_CONTENT_LENGTH=200000

# Story pages must reflect publish/unpublish/archive immediately
PUBLIC_STORY_CACHE_CONTROL=no-cache
